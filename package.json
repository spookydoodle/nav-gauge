{
    "name": "@the-dead-planet/nav-gauge",
    "version": "1.0.0",
    "description": "Navigation gauge and route story generator.",
    "homepage": "https://gauge.spookydoodle.com",
    "private": true,
    "license": "AGPL-3.0",
    "author": "spookydoodle",
    "funding": "https://ko-fi.com/spookydoodle",
    "repository": "https://github.com/the-dead-planet/nav-gauge",
    "bugs": {
        "url": "https://github.com/the-dead-planet/nav-gauge/issues"
    },
    "scripts": {
        "analyze:web": "yarn workspace @the-dead-planet/nav-gauge-app-web analyze",
        "dev:web": "yarn workspace @the-dead-planet/nav-gauge-app-web dev",
        "dev:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile dev",
        "dev:mobile:r": "yarn workspace @the-dead-planet/nav-gauge-app-mobile dev:r",
        "dev:ui:web": "yarn workspace @the-dead-planet/nav-gauge-ui-web storybook",
        "start:web": "yarn workspace @the-dead-planet/nav-gauge-app-web start",
        "build:web": "yarn workspace @the-dead-planet/nav-gauge-app-web build",
        "build:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile build",
        "build:ui:web": "yarn workspace @the-dead-planet/nav-gauge-ui-web build-storybook",
        "typecheck:web": "yarn workspace @the-dead-planet/nav-gauge-app-web typecheck",
        "typecheck:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile typecheck",
        "typecheck:mobile:once": "yarn workspace @the-dead-planet/nav-gauge-app-mobile typecheck:once",
        "test:all": "concurrently \"yarn test:web\" \"yarn test:mobile\"",
        "test:common": "yarn test:tinker-chest && yarn test:apparatus-common && yarn test:gears-common && yarn test:ui:common",
        "test:mobile": "yarn test:common && yarn test:apparatus-mobile && yarn test:app-mobile && yarn test:gears-mobile && yarn test:ui:mobile",
        "test:web": "yarn test:common && yarn test:apparatus-web && yarn test:app-web && yarn test:gears-web && yarn test:ui:web",
        "test:app-web": "yarn workspace @the-dead-planet/nav-gauge-app-web test",
        "test:app-mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile test",
        "test:gears": "yarn test:gears-common && yarn test:gears-mobile && yarn test:gears-web",
        "test:gears-common": "yarn tsx ./scripts/app/test-gears.ts common",
        "test:gears-mobile": "yarn tsx ./scripts/app/test-gears.ts mobile",
        "test:gears-web": "yarn tsx ./scripts/app/test-gears.ts web",
        "test:gear": "yarn tsx ./scripts/app/test-gear.ts",
        "test:apparatus-common": "yarn workspace @the-dead-planet/nav-gauge-apparatus-common test",
        "test:apparatus-mobile": "yarn workspace @the-dead-planet/nav-gauge-apparatus-mobile test",
        "test:apparatus-web": "yarn workspace @the-dead-planet/nav-gauge-apparatus-web test",
        "test:tinker-chest": "yarn workspace @the-dead-planet/nav-gauge-tinker-chest test",
        "test:ui": "yarn test:ui:common && yarn test:ui:mobile && yarn test:ui:web",
        "test:ui:common": "yarn workspace @the-dead-planet/nav-gauge-ui-common test",
        "test:ui:mobile": "yarn workspace @the-dead-planet/nav-gauge-ui-mobile test",
        "test:ui:web": "yarn workspace @the-dead-planet/nav-gauge-ui-web test",
        "test:e2e:web": "yarn workspace @the-dead-planet/nav-gauge-app-web test:e2e:prod",
        "test:e2e:web:dev": "yarn workspace @the-dead-planet/nav-gauge-app-web test:e2e:dev",
        "test:e2e:mobile": "yarn workspace @the-dead-planet/nav-gauge-app-mobile test:e2e:prod",
        "test:e2e:mobile:dev": "yarn workspace @the-dead-planet/nav-gauge-app-mobile test:e2e:dev",
        "generate:gear": "yarn tsx ./scripts/app/generate-gear.ts",
        "add:gear": "yarn tsx ./scripts/app/add-to-gear.ts",
        "icons": "yarn tsx ./ui/common/src/icons/svg/noun-project/process-icons.ts",
        "lint": "npx eslint . --no-warn-ignored"
    },
    "dependencies": {
        "@maplibre/maplibre-gl-style-spec": "^26.4.1",
        "@turf/along": "^7.4.0",
        "@turf/bbox": "^7.4.0",
        "@turf/bearing": "^7.4.0",
        "@turf/bezier-spline": "^7.4.0",
        "@turf/distance": "^7.4.0",
        "@turf/helpers": "^7.4.0",
        "@turf/length": "^7.4.0",
        "luxon": "^3.7.2",
        "react": "19.2.8",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@types/chai": "^5.2.3",
        "@types/eslint": "^9.6.1",
        "@types/luxon": "^3.7.5",
        "@types/mocha": "^10.0.10",
        "@types/react": "^19.2.18",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "chai": "^6.2.2",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "mocha": "^12.0.0",
        "path": "^0.12.7",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "resolutions": {
        "brace-expansion": "^1.1.13",
        "qs": "^6.14.1",
        "serialize-javascript": "^7.0.5",
        "uuid": "^14.0.0"
    },
    "workspaces": {
        "packages": [
            "app-web",
            "app-mobile",
            "ui/*",
            "apparatus/*",
            "tinker-chest",
            "gears/*/common",
            "gears/*/mobile",
            "gears/*/web"
        ]
    },
    "packageManager": "yarn@4.18.0"
}

        "react-native-screens": "^4.27.0",
        "react-native-svg": "^15.15.5",
        "react-native-view-recorder": "patch:react-native-view-recorder@npm%3A0.4.1#~/.yarn/patches/react-native-view-recorder-npm-0.4.1-f65f857d14.patch",

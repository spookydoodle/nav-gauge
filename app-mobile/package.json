    "scripts": {
        "build": "react-native build-android",
        "ios": "react-native run-ios",
        "lint": "eslint . --max-warnings -1",
        "dev:typecheck": "concurrently -n METRO,TSC -c green,blue \"react-native start\" \"yarn typecheck\"",
        "dev": "react-native start",
        "dev:r": "concurrently -n METRO,TSC -c green,blue \"react-native start --reset-cache\" \"yarn typecheck\"",
        "start": "react-native start --reset-cache",
        "test": "mocha",
        "test:e2e": "jest",
        "test:e2e:dev": "jest",
        "test:e2e:prod": "jest",
        "typecheck": "tsc --noEmit --watch",
        "typecheck:once": "tsc --noEmit"
    },

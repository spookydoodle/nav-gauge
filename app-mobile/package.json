        "@types/jest": "^30.0.0",
        "@types/serve-static": "^2",
        "babel-jest": "^30.5.1",
        "babel-plugin-module-resolver": "^5.0.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "prettier": "^3.9.6",
